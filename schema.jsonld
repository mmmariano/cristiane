    {
      "@type": "FAQPage",
      "@id": "https://cristianemoreira.psi.br/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como funciona a terapia online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As sessões acontecem por videochamada em um ambiente seguro e privado. Você só precisa de um celular ou computador com internet. A qualidade e profundidade do atendimento são iguais às de uma consulta presencial."
          }
        },
        {
          "@type": "Question",
          "name": "Atende brasileiros fora do Brasil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Atendo brasileiros que vivem em qualquer país, incluindo Canadá, Austrália, Estados Unidos e Portugal. A terapia online permite suporte profissional em português, onde quer que você esteja."
          }
        },
        {
          "@type": "Question",
          "name": "Com que frequência acontecem as sessões?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A frequência mais recomendada é semanal, pois permite um trabalho contínuo e mais profundo. Conversamos sobre a melhor opção para a sua realidade e necessidade."
          }
        },
        {
          "@type": "Question",
          "name": "Como faço para agendar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta enviar uma mensagem pelo WhatsApp (31) 99574-7671. Conversamos brevemente para entender o que você busca e agendamos a primeira sessão."
          }
        },
        {
          "@type": "Question",
          "name": "As sessões são sigilosas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. O sigilo é um princípio ético fundamental da psicologia. Tudo o que você compartilha nas sessões permanece em total confidencialidade."
          }
        }
      ]
    },
